# Migration Container for K8s-Native Migrations
# This container runs hyper2kvm inside Kubernetes to perform migrations
#
# Uses VMCraft backend (hyper2kvm's native Python implementation)
# - No libguestfs dependency
# - Faster startup (~2s vs ~10s)
# - Pure Python with qemu-nbd for disk access

FROM fedora:43

LABEL org.opencontainers.image.source="https://github.com/hyper2kvm/hyper2kvm"
LABEL org.opencontainers.image.description="hyper2kvm migration container for Kubernetes-native VM migrations"
LABEL org.opencontainers.image.licenses="LGPL-3.0-or-later"

# Force VMCraft backend (default, but explicit)
ENV HYPER2KVM_GUESTFS_BACKEND=vmcraft

# Install minimal system dependencies for VMCraft backend
# VMCraft is hyper2kvm's native Python implementation - no libguestfs needed!
RUN dnf install -y \
    # Core Python
    python3 \
    python3-pip \
    # Image conversion and NBD client
    qemu-img \
    qemu-kvm-core \
    # Filesystem tools (for VMCraft mount operations)
    e2fsprogs \
    xfsprogs \
    btrfs-progs \
    dosfstools \
    util-linux \
    # LVM and encryption support
    lvm2 \
    cryptsetup \
    # Partitioning tools
    parted \
    gdisk \
    # Boot configuration tools (for offline fixes)
    dracut \
    dracut-network \
    grub2-tools \
    # systemd (for systemd-related operations)
    systemd \
    && dnf clean all

# Install Python dependencies
RUN pip3 install --no-cache-dir \
    pyyaml \
    jinja2 \
    click \
    rich \
    kubernetes

# Copy hyper2kvm source
WORKDIR /app
COPY . /app/

# Install hyper2kvm
RUN pip3 install --no-cache-dir -e .

# Create working directories
RUN mkdir -p /vmroot /output /source

# Set entrypoint
ENTRYPOINT ["h2kvmctl"]
CMD ["--help"]
