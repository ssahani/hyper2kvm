{
  "$schema": "https://hyper2kvm.io/schemas/manifest/v1.json",
  "version": "1.0",
  "metadata": {
    "name": "production-webserver-migration",
    "description": "Migrate production web server from VMware to KVM",
    "created": "2024-01-21T10:00:00Z",
    "owner": "ops-team@example.com"
  },
  "source": {
    "type": "vmdk",
    "path": "/data/vms/webserver/disk.vmdk",
    "format": "vmdk",
    "checksum": {
      "algorithm": "sha256",
      "value": "abc123..."
    }
  },
  "output": {
    "directory": "/data/output/webserver",
    "format": "qcow2",
    "filename": "webserver-migrated.qcow2",
    "compress": true,
    "compress_level": 6
  },
  "pipeline": {
    "inspect": {
      "enabled": true,
      "collect_guest_info": true,
      "validate_bootloader": true
    },
    "fix": {
      "enabled": true,
      "fstab_mode": "stabilize-all",
      "update_grub": true,
      "regen_initramfs": true,
      "network_fixes": "moderate",
      "remove_vmware_tools": true
    },
    "convert": {
      "enabled": true,
      "flatten": true,
      "atomic": true
    },
    "validate": {
      "enabled": true,
      "check_image_integrity": true,
      "verify_bootability": false,
      "smoke_test": false
    }
  },
  "configuration": {
    "users": {
      "create": [
        {
          "name": "admin",
          "uid": 1000,
          "groups": ["wheel", "docker"],
          "ssh_keys": ["ssh-rsa AAAAB3..."],
          "sudo": "ALL=(ALL) NOPASSWD:ALL"
        }
      ],
      "disable": ["ubuntu", "centos"]
    },
    "services": {
      "enable": ["sshd", "nginx", "docker"],
      "disable": ["bluetooth", "cups"],
      "mask": ["snapd"]
    },
    "hostname": {
      "name": "webserver01",
      "domain": "prod.example.com",
      "hosts": {
        "192.168.1.10": "db.prod.example.com",
        "192.168.1.20": "cache.prod.example.com"
      }
    },
    "network": {
      "files": [
        {
          "type": "network",
          "name": "eth0",
          "priority": 10,
          "content": "[Match]\nName=eth0\n\n[Network]\nAddress=192.168.1.100/24\nGateway=192.168.1.1\n"
        }
      ]
    }
  },
  "options": {
    "dry_run": false,
    "verbose": 2,
    "parallel": false,
    "backup": true,
    "report": {
      "enabled": true,
      "format": "json",
      "path": "report.json"
    }
  }
}
