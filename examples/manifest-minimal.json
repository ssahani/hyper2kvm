{
  "version": "1.0",
  "metadata": {
    "name": "simple-migration"
  },
  "source": {
    "type": "vmdk",
    "path": "/path/to/disk.vmdk"
  },
  "output": {
    "directory": "/path/to/output",
    "format": "qcow2"
  },
  "pipeline": {
    "inspect": {"enabled": true},
    "fix": {"enabled": true},
    "convert": {"enabled": true},
    "validate": {"enabled": true}
  }
}
